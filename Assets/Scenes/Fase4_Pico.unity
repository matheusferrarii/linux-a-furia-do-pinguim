  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: inicio
  displayName: "Anci\xE3o Tux"
  firstTalk:
  - speaker: 
    text: "Chegamos ao Pico da Montanha Ancestral. A nevasca n\xE3o para e o BSOD
      espera no topo."
  - speaker: 
    text: "Ele usa TUDO: pis\xE3o, estilha\xE7os, investida, chuva de gelo e monstros.
      Cinco n\xFAcleos."
  - speaker: 
    text: "Se ele vencer, o reino trava para sempre. V\xE1, Linux!"
