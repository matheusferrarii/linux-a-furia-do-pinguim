  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: arch
  displayName: Construtora Arch
  firstTalk:
  - speaker: 
    text: "O vale virou um rinque! Gelo para todo lado e as fendas est\xE3o mais
      largas."
  - speaker: 
    text: "Os peixes dourados se esconderam de novo nos cantos. Ache todos: cada
      um recupera um cora\xE7\xE3o."
  repeatTalk:
  - speaker: 
    text: "No gelo, frear demora: pule as fendas com anteced\xEAncia!"
  activateMissions:
  - dourados
  model: {fileID: 1219746570}
  attentionMarker: {fileID: 896857140}
  talkRadius: 4.5
