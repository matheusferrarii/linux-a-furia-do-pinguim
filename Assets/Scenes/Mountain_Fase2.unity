  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: fedora
  displayName: "Guardi\xE3 Fedora"
  firstTalk:
  - speaker: 
    text: "Cuidado, Linux! Desde que ele passou, as estalactites das ru\xEDnas n\xE3o
      param de cair."
  - speaker: 
    text: "E os capangas agora atiram mais r\xE1pido e de mais longe. Use a mira
      e n\xE3o fique parado na frente deles."
  - speaker: 
    text: "Ative os checkpoints: hoje voc\xEA vai precisar."
  repeatTalk:
  - speaker: 
    text: "Sombras no ch\xE3o = gelo caindo. Capangas: ande de lado e revide."
  activateMissions:
  - checkpoints
  model: {fileID: 2011130573}
  attentionMarker: {fileID: 1704519455}
  talkRadius: 4.5
