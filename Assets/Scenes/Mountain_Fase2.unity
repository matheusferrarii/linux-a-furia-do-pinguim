--- !u!114 &27776996
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 27776994}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: gentoo
  displayName: "S\xE1bio Gentoo"
  firstTalk:
  - speaker: 
    text: "Linux! Voc\xEA derrubou o BSOD... mas ele n\xE3o foi desligado. Ele REINICIOU."
  - speaker: 
    text: "Durante a noite o n\xFAcleo dele desceu a montanha. Est\xE1 indo direto
      para a vila."
  - speaker: 
    text: "E voltou pior: mais capangas, Monstros de Gelo mais ferozes e o pr\xF3prio
      BSOD mais resistente."
  - speaker: 
    text: "Des\xE7a a montanha sem parar. Se voc\xEA hesitar, a vila trava para sempre!"
  repeatTalk:
  - speaker: 
    text: "Des\xE7a at\xE9 a vila! N\xE3o pare!"
  activateMissions:
  - vila
  - peixes
  - capangas
  model: {fileID: 220349825}
  attentionMarker: {fileID: 790691684}
  talkRadius: 4.5
