  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: anciao
  displayName: "Anci\xE3o Tux"
  firstTalk:
  - speaker: 
    text: "Linux! O BSOD reiniciado est\xE1 logo al\xE9m daquele portal, cercando
      a vila."
  - speaker: 
    text: "Ele est\xE1 mais resistente: s\xE3o quatro n\xFAcleos, e ele demora mais
      para travar."
  - speaker: 
    text: "E fica travado por menos tempo. Quando a tela azul aparecer, n\xE3o desperdice
      a chance."
  - speaker: 
    text: "\xC9 agora ou nunca. Desligue esse BSOD de uma vez por todas!"
  repeatTalk:
  - speaker: 
    text: "Quatro n\xFAcleos. Encha a barra, espere travar e acerte!"
  activateMissions:
  - boss
  model: {fileID: 1639884194}
  attentionMarker: {fileID: 1888295037}
  talkRadius: 4.5
