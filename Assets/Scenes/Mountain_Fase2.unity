  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: debi
  displayName: Batedora Debi
  firstTalk:
  - speaker: 
    text: "Os Monstros de Gelo est\xE3o mais r\xE1pidos: o aviso antes do bote ficou
      bem curto."
  - speaker: 
    text: "Dica de batedora: acerte uma bola de neve enquanto ele treme e o bote
      \xE9 cancelado."
  - speaker: 
    text: "O Anci\xE3o est\xE1 na vila, logo \xE0 frente. Corre!"
  repeatTalk:
  - speaker: 
    text: Acerte o monstro enquanto ele treme para cancelar o bote!
  activateMissions:
  - falar_anciao
  model: {fileID: 1903435946}
  attentionMarker: {fileID: 1763873536}
  talkRadius: 4.5
