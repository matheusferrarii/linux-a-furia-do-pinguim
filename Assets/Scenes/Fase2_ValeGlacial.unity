  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: debi
  displayName: Batedora Debi
  firstTalk:
  - speaker: 
    text: "O vale est\xE1 coberto de gelo e de fendas. No gelo, frear demora: pule
      com anteced\xEAncia."
  - speaker: 
    text: "E os monstros daqui atacam r\xE1pido. Quando tremerem, j\xE1 desvie!"
  repeatTalk:
  - speaker: 
    text: 'Gelo: freie cedo e pule as fendas!'
  activateMissions:
  - checkpoints
  model: {fileID: 1808311914}
  attentionMarker: {fileID: 1322785559}
  talkRadius: 4.5
