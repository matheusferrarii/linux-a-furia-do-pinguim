  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: inicio
  displayName: "S\xE1bio Gentoo"
  firstTalk:
  - speaker: 
    text: "Linux, o BSOD n\xE3o foi desligado: ele REINICIOU e mandou um guarda \xE0
      frente."
  - speaker: 
    text: "No fim deste vale est\xE1 o KERNEL PANIC, uma fera que se joga em investidas.
      Quando ele se agachar, saia da frente!"
  - speaker: 
    text: "Ele s\xF3 fica vulner\xE1vel por instantes: espere a mira ficar VERDE
      para acertar. Fora disso ele defende."
  repeatTalk:
  - speaker: 
    text: Mira verde = ataque. Mira cinza = ele defende.
  activateMissions:
  - topo
  - peixes
  - capangas
  model: {fileID: 728184692}
  attentionMarker: {fileID: 636059770}
  talkRadius: 4.5
