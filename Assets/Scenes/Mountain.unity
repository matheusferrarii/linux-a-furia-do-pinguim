  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: fedora
  displayName: "Guardi\xE3 Fedora"
  firstTalk:
  - speaker: 
    text: "Alto! Ah, \xE9 voc\xEA, Linux. Sou a Fedora, guardi\xE3 do caminho da
      montanha."
  - speaker: 
    text: "Daqui pra frente a trilha sobe at\xE9 o pico. O frio fica mais forte e
      os capangas, mais numerosos."
  - speaker: 
    text: "O S\xE1bio Gentoo espera no cume. Ele compilou tudo o que sabemos sobre
      o BSOD... levou s\xF3 alguns dias."
  repeatTalk:
  - speaker: 
    text: "O S\xE1bio Gentoo est\xE1 no cume. Siga a trilha para cima!"
  activateMissions:
  - falar_gentoo
  model: {fileID: 1856494785}
  attentionMarker: {fileID: 383328085}
  talkRadius: 4.5
