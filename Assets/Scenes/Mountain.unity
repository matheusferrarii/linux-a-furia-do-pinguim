MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1766958726}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1170d03e3ebffef4bb3f68ad1e1ba034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: arch
  displayName: Construtora Arch
  firstTalk:
  - speaker: 
    text: "Eu sou a Arch. Constru\xED meu iglu pe\xE7a por pe\xE7a, do jeito que
      eu quis, e n\xE3o vou deixar o BSOD congelar tudo num formato s\xF3."
  - speaker: 
    text: "Ouvi dizer que existem peixes dourados escondidos nos cantos do caminho.
      Eles valem muito... e recuperam um cora\xE7\xE3o!"
  - speaker: 
    text: Fique de olho nos cantinhos e desvios. Quem explora encontra.
  repeatTalk:
  - speaker: 
    text: "Os peixes dourados ficam nos cantos, fora do caminho principal. Eles curam
      um cora\xE7\xE3o!"
  activateMissions:
  - dourados
  model: {fileID: 95529572}
  attentionMarker: {fileID: 257588542}
  talkRadius: 4.5
