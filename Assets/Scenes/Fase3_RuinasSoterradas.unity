  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: arch
  displayName: Construtora Arch
  firstTalk:
  - speaker: 
    text: "Estes arcos eram de um povo antigo de pinguins. O BSOD soterrou tudo num
      s\xF3 formato."
  - speaker: 
    text: "Os peixes dourados ca\xEDram entre os escombros. Explore!"
  repeatTalk:
  - speaker: 
    text: "Dourados nos cantos das ru\xEDnas!"
  activateMissions:
  - dourados
