  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LinuxFuriaPinguim.NpcDialogue
  npcId: inicio
  displayName: "Guardi\xE3 Fedora"
  firstTalk:
  - speaker: 
    text: "Bem-vindo \xE0s Ru\xEDnas Soterradas. Os corredores s\xE3o estreitos e
      o teto range: olhe as sombras no ch\xE3o."
  - speaker: 
    text: "No fundo das ru\xEDnas vive o SEGFAULT. Ele invoca Monstros de Gelo e
      faz chover gelo. N\xE3o fique parado!"
  repeatTalk:
  - speaker: 
    text: "Sombra no ch\xE3o = gelo caindo!"
  activateMissions:
  - topo
  - peixes
  - capangas
  model: {fileID: 1205195842}
  attentionMarker: {fileID: 549563635}
  talkRadius: 4.5
